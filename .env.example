# MySQL — local WAMP
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=reeferon_crm_db
DB_PORT=3306

# Railway: use the MySQL plugin vars (same project as this backend).
# Prefer DATABASE_URL from Railway. Private host only works inside Railway.
# DATABASE_URL=mysql://user:pass@mysql.railway.internal:3306/railway
# DB_HOST=${MYSQLHOST}
# DB_PORT=${MYSQLPORT}
# DB_USER=${MYSQLUSER}
# DB_PASSWORD=${MYSQLPASSWORD}
# DB_NAME=${MYSQLDATABASE}
# DB_POOL_LIMIT=8

PORT=5000
JWT_SECRET=change_me_to_a_long_random_secret
NODE_ENV=development

# --- Local: Gmail SMTP (send to ANY recipient) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_PREFER_SMTP=true

# --- Deploy: Resend (any recipient needs verified domain) ---
RESEND_API_KEY=
EMAIL_FROM=ReeferON <onboarding@resend.dev>

APP_LOGIN_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
MOBILE_APP_URL=
MOBILE_DEEP_LINK=reeferon://login

# Photos: Cloudinary-style folders on this server
#   uploads/crm/inward_images
#   uploads/crm/outward_images
#   uploads/crm/daily_temp_monitor_images
# Railway Volume → UPLOADS_DIR=/data/uploads
UPLOADS_DIR=
UPLOAD_TO_CLOUDINARY=false

# Keep Cloudinary keys only if you still want CDN fallback while importing backup.
# Existing DB URLs (res.cloudinary.com/...) are NOT rewritten.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
