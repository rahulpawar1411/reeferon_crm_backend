# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=reeferon_crm_db
DB_PORT=3306

# Optional: LOG_ALL_STATUS=1 to print every request status (default: only 4xx/5xx)
# LOG_ALL_STATUS=0

PORT=5000
JWT_SECRET=change_me_to_a_long_random_secret

# Gmail SMTP — credentials mail on DO / Sub-Admin create
# 1) Enable 2-Step Verification
# 2) App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=ReeferON <your.gmail@gmail.com>
APP_LOGIN_URL=http://localhost:3000

# DO credentials email — app install + open
MOBILE_APP_URL=
MOBILE_DEEP_LINK=reeferon://login
