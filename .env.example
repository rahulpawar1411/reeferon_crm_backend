# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=reeferon_crm_db
DB_PORT=3306

# Optional: LOG_ALL_STATUS=1 to print every request status (default: only 4xx/5xx)
# LOG_ALL_STATUS=0

PORT=5000
JWT_SECRET=change_me_to_a_long_random_secret

# Resend Email API — credentials mail on DO / Sub-Admin create
# Get key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# After domain verify, use: ReeferON CRM <noreply@yourdomain.com>
# Until then Resend test sender works (often only to your signup email):
EMAIL_FROM=ReeferON CRM <onboarding@resend.dev>
APP_LOGIN_URL=http://localhost:3000
